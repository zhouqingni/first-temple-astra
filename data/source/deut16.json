  "proc": 0,
  "record": [
    {
      "chineses": "申",
      "engs": "Deut",
      "chap": 16,
      "sec": 1,
      "bible_text": "「你要注意亚笔月，向耶和华―你的　神守逾越节，因为耶和华―你的　神在亚笔月夜间领你出埃及。"
    },
    {
      "chineses": "申",
      "engs": "Deut",
      "chap": 16,
      "sec": 2,
      "bible_text": "你当在耶和华所选择要立为他名的居所，从牛群羊群中，将逾越节的祭牲献给耶和华―你的　神。"
    },
    {
      "chineses": "申",
      "engs": "Deut",
      "chap": 16,
      "sec": 3,
      "bible_text": "你吃这祭牲，不可吃有酵的饼；七日之内要吃无酵饼，就是困苦饼―你本是急忙出了埃及地―要叫你一生一世记念你从埃及地出来的日子。"
    },
    {
      "chineses": "申",
      "engs": "Deut",
      "chap": 16,
      "sec": 4,
      "bible_text": "在你四境之内，七日不可见面酵，头一日晚上所献的肉，一点不可留到早晨。"
    },
    {
      "chineses": "申",
      "engs": "Deut",
      "chap": 16,
      "sec": 5,
      "bible_text": "在耶和华―你　神所赐的各城中，你不可献逾越节的祭；"
    },
    {
      "chineses": "申",
      "engs": "Deut",
      "chap": 16,
      "sec": 6,
      "bible_text": "只当在耶和华―你　神所选择要立为他名的居所，晚上日落的时候，乃是你出埃及的时候，献逾越节的祭。"
    },
    {
      "chineses": "申",
      "engs": "Deut",
      "chap": 16,
      "sec": 7,
      "bible_text": "当在耶和华―你　神所选择的地方把肉烤了吃（烤：或译煮），次日早晨就回到你的帐棚去。"
    },
    {
      "chineses": "申",
      "engs": "Deut",
      "chap": 16,
      "sec": 8,
      "bible_text": "你要吃无酵饼六日，第七日要向耶和华―你的　神守严肃会，不可做工。」"
    },
    {
      "chineses": "申",
      "engs": "Deut",
      "chap": 16,
      "sec": 9,
      "bible_text": "「你要计算七七日：从你开镰收割禾稼时算起，共计七七日。"
    },
    {
      "chineses": "申",
      "engs": "Deut",
      "chap": 16,
      "sec": 10,
      "bible_text": "你要照耶和华―你　神所赐你的福，手里拿着甘心祭，献在耶和华―你的　神面前，守七七节。"
    },
    {
      "chineses": "申",
      "engs": "Deut",
      "chap": 16,
      "sec": 11,
      "bible_text": "你和你儿女、仆婢，并住在你城里的利未人，以及在你们中间寄居的与孤儿寡妇，都要在耶和华―你　神所选择立为他名的居所，在耶和华―你的　神面前欢乐。"
    },
    {
      "chineses": "申",
      "engs": "Deut",
      "chap": 16,
      "sec": 12,
      "bible_text": "你也要记念你在埃及作过奴仆。你要谨守遵行这些律例。」"
    },
    {
      "chineses": "申",
      "engs": "Deut",
      "chap": 16,
      "sec": 13,
      "bible_text": "「你把禾场的谷、酒榨的酒收藏以后，就要守住棚节七日。"
    },
    {
      "chineses": "申",
      "engs": "Deut",
      "chap": 16,
      "sec": 14,
      "bible_text": "守节的时候，你和你儿女、仆婢，并住在你城里的利未人，以及寄居的与孤儿寡妇，都要欢乐。"
    },
    {
      "chineses": "申",
      "engs": "Deut",
      "chap": 16,
      "sec": 15,
      "bible_text": "在耶和华所选择的地方，你当向耶和华―你的　神守节七日；因为耶和华―你　神在你一切的土产上和你手里所办的事上要赐福与你，你就非常地欢乐。"
    },
    {
      "chineses": "申",
      "engs": "Deut",
      "chap": 16,
      "sec": 16,
      "bible_text": "你一切的男丁要在除酵节、七七节、住棚节，一年三次，在耶和华―你　神所选择的地方朝见他，却不可空手朝见。"
    },
    {
      "chineses": "申",
      "engs": "Deut",
      "chap": 16,
      "sec": 17,
      "bible_text": "各人要按自己的力量，照耶和华―你　神所赐的福分，奉献礼物。」"
    },
    {
      "chineses": "申",
      "engs": "Deut",
      "chap": 16,
      "sec": 18,
      "bible_text": "「你要在耶和华―你　神所赐的各城里，按着各支派设立审判官和官长。他们必按公义的审判判断百姓。"
    },
    {
      "chineses": "申",
      "engs": "Deut",
      "chap": 16,
      "sec": 19,
      "bible_text": "不可屈枉正直；不可看人的外貌。也不可受贿赂；因为贿赂能叫智慧人的眼变瞎了，又能颠倒义人的话。"
    },
    {
      "chineses": "申",
      "engs": "Deut",
      "chap": 16,
      "sec": 20,
      "bible_text": "你要追求至公至义，好叫你存活，承受耶和华―你　神所赐你的地。"
    },
    {
      "chineses": "申",
      "engs": "Deut",
      "chap": 16,
      "sec": 21,
      "bible_text": "「你为耶和华―你的　神筑坛，不可在坛旁栽甚么树木作为木偶。"
    },
    {
      "chineses": "申",
      "engs": "Deut",
      "chap": 16,
      "sec": 22,
      "bible_text": "也不可为自己设立柱像；这是耶和华―你　神所恨恶的。"
    }
  ]
}

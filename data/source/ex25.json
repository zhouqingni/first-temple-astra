{
  "status": "success",
  "record_count": 40,
  "proc": 0,
  "record": [
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 1,
      "bible_text": "耶和华晓谕摩西说："
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 2,
      "bible_text": "「你告诉以色列人当为我送礼物来；凡甘心乐意的，你们就可以收下归我。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 3,
      "bible_text": "所要收的礼物：就是金、银、铜，"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 4,
      "bible_text": "蓝色、紫色、朱红色线，细麻，山羊毛，"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 5,
      "bible_text": "染红的公羊皮，海狗皮，皂荚木，"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 6,
      "bible_text": "点灯的油并做膏油和香的香料，"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 7,
      "bible_text": "红玛瑙与别样的宝石，可以镶嵌在以弗得和胸牌上。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 8,
      "bible_text": "又当为我造圣所，使我可以住在他们中间。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 9,
      "bible_text": "制造帐幕和其中的一切器具都要照我所指示你的样式。」"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 10,
      "bible_text": "「要用皂荚木做一柜，长二肘半，宽一肘半，高一肘半。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 11,
      "bible_text": "要里外包上精金，四围镶上金牙边。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 12,
      "bible_text": "也要铸四个金环，安在柜的四脚上；这边两环，那边两环。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 13,
      "bible_text": "要用皂荚木做两根杠，用金包裹。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 14,
      "bible_text": "要把杠穿在柜旁的环内，以便抬柜。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 15,
      "bible_text": "这杠要常在柜的环内，不可抽出来。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 16,
      "bible_text": "必将我所要赐给你的法版放在柜里。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 17,
      "bible_text": "要用精金做施恩座（施恩：或译蔽罪；下同），长二肘半，宽一肘半。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 18,
      "bible_text": "要用金子锤出两个基路伯来，安在施恩座的两头。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 19,
      "bible_text": "这头做一个基路伯，那头做一个基路伯，二基路伯要接连一块，在施恩座的两头。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 20,
      "bible_text": "二基路伯要高张翅膀，遮掩施恩座。基路伯要脸对脸，朝着施恩座。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 21,
      "bible_text": "要将施恩座安在柜的上边，又将我所要赐给你的法版放在柜里。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 22,
      "bible_text": "我要在那里与你相会，又要从法柜施恩座上二基路伯中间，和你说我所要吩咐你传给以色列人的一切事。」"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 23,
      "bible_text": "「要用皂荚木做一张桌子，长二肘，宽一肘，高一肘半。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 24,
      "bible_text": "要包上精金，四围镶上金牙边。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 25,
      "bible_text": "桌子的四围各做一掌宽的横梁，横梁上镶着金牙边。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 26,
      "bible_text": "要做四个金环，安在桌子的四角上，就是桌子四脚上的四角。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 27,
      "bible_text": "安环子的地方要挨近横梁，可以穿杠抬桌子。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 28,
      "bible_text": "要用皂荚木做两根杠，用金包裹，以便抬桌子。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 29,
      "bible_text": "要做桌子上的盘子、调羹，并奠酒的爵和瓶；这都要用精金制作。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 30,
      "bible_text": "又要在桌子上，在我面前，常摆陈设饼。」"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 31,
      "bible_text": "「要用精金做一个灯台。灯台的座和干与杯、球、花，都要接连一块锤出来。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 32,
      "bible_text": "灯台两旁要杈出六个枝子：这旁三个，那旁三个。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 33,
      "bible_text": "这旁每枝上有三个杯，形状像杏花，有球，有花；那旁每枝上也有三个杯，形状像杏花，有球，有花。从灯台杈出来的六个枝子都是如此。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 34,
      "bible_text": "灯台上有四个杯，形状像杏花，有球，有花。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 35,
      "bible_text": "灯台每两个枝子以下有球与枝子接连一块。灯台出的六个枝子都是如此。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 36,
      "bible_text": "球和枝子要接连一块，都是一块精金锤出来的。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 37,
      "bible_text": "要做灯台的七个灯盏。祭司要点这灯，使灯光对照。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 38,
      "bible_text": "灯台的蜡剪和蜡花盘也是要精金的。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 39,
      "bible_text": "做灯台和这一切的器具要用精金一他连得。"
    },
    {
      "chineses": "出",
      "engs": "Ex",
      "chap": 25,
      "sec": 40,
      "bible_text": "要谨慎做这些物件，都要照着在山上指示你的样式。」"
    }
  ]
}
